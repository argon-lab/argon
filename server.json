{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.argon-lab/argon",
  "description": "MongoDB sandboxes for AI agents, Git for MongoDB underneath: branch, diff, merge, undo over MCP.",
  "repository": {
    "url": "https://github.com/argon-lab/argon",
    "source": "github"
  },
  "version": "2.5.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "argonctl",
      "version": "2.5.0",
      "runtimeHint": "npx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "--allow-scripts=argonctl"
        }
      ],
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
